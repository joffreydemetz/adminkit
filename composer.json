{
    "name": "jdz/adminkit",
    "type": "library",
    "description": "Framework-agnostic admin list/item orchestration primitives: pagination, filter-state resolution, ordering validation, query building, uniqueness and data sanitization",
    "keywords": ["JDZ", "admin", "list", "pagination", "filter"],
    "homepage": "https://jdz.joffreydemetz.com/adminkit",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "jdz/database": "^2.1",
        "jdz/form": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\AdminKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\AdminKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox",
        "test-coverage": ["@putenv XDEBUG_MODE=coverage", "phpunit --coverage-html coverage"]
    }
}
